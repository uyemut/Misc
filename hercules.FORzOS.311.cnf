#**********************************************************************************************
#*****             Init IPL parameters config Operating System z/OS 3.1 VSI               *****
#**********************************************************************************************
#***** without this dont work
ARCHLVL  z/ARCH 
FACILITY ENABLE 006_ASN_LX_REUSE
FACILITY ENABLE 044_PFPO 
FACILITY ENABLE 080_DFP_PACK_CONV
FACILITY ENABLE 037_FP_EXTENSION
FACILITY ENABLE 050_CONSTR_TRANSACT
FACILITY ENABLE 051_LOCAL_TLB_CLEARING 
FACILITY ENABLE 073_TRANSACT_EXEC
FACILITY ENABLE 074_STORE_HYPER_INFO
FACILITY ENABLE 145_INS_REF_BITS_MULT

##FACILITY QUERY ENABLED
##FACILITY QUERY ALL

**********
* WARNING execute on command line before IPL/LOADPARM 
* on hercules ---> 'FAC ENA 054' 'FAC ENA 129' 'FAC ENA 130' 'FAC ENA 134' and 'FAC ENA 135' 
*********
*FACILITY  ENABLE  054       # 054_EE_CMPSC
*FACILITY  ENABLE  129       # 129_ZVECTOR
*FACILITY  ENABLE  130       # 130_INSTR_EXEC_PROT
*FACILITY  ENABLE  134       # 134_ZVECTOR_PACK_DEC
*FACILITY  ENABLE  135       # 135_ZVECTOR_ENH_1
***** without this dont work

##CNSLPORT 992
CNSLPORT 3270

CODEPAGE  DEFAULT
CPUMODEL  8562	   # CPU model number - Z15
CPUSERIAL 02B7F8     # CPU serial number - Z15
MODEL     T02 S03        # STSI returned Hardware model Capacity model - Z15
CPUVERID  00
ENGINES   CP   


PANOPT  FULLPATH RATE=500 MSGCOLOR=YES TITLE="z/OS 3.1 of 2026 on Hercules V4.9.1  IPL DE27"


***********
* IPL DE27
* LOADPARMS  from  SYS0.IPLPARM and ...
***********
LOADPARM  DE28K2M.		##  K2.* overrides
###LOADPARM  DE28A0..		##  All the same as "K2" except IEASYM Members
###LOADPARM  DE28AU		##  All SYSPLEX LOCAL, all SYSCAT in OPEVS1 Pack
###LOADPARM  DE28A0
###LOADPARM  DE28AU
###LOADPARM  DE28GK
###LOADPARM  DE28NZ
###LOADPARM  DE28ZT

##LOG       D:\share\herc4.8\LOGS\logzOS
##MODPATH   D:\share\herc4.8

LOGOPT    TIMESTAMP

LPARNAME  VS01
MAINSIZE  12G
MANUFACTURER IBM
MAXCPU    8 
NUMCPU    6

OSTAILOR  z/OS
PGMPRDOS  LICENSED 
PLANT     02
SYSEPOCH  1900
TZOFFSET  -0300
TIMERINT 400
CONKPALV (3,1,10)

#********************************************************************
# SYMBOLS DEFINITION                                                *
#********************************************************************

DEFSYM DASD "G:\DSD2"
DEFSYM PROD "PROD"
DEFSYM SPOOL "SPOOL"
DEFSYM PRTR "PRTR"
DEFSYM SHDW "SHADOW"

#**********************************************************************************************
#*****         Reserved area to OS z/OS and products                                      *****
#**********************************************************************************************
###########
#IPL DE27
###########
DE25 3390   $(DASD)/CICS61.CCKD cu=3990-6    sf=$(SHDW)/CICS61_*
DE26 3390   $(DASD)/D31VS1.CCKD cu=3990-6  sf=$(SHDW)/D31VS1_*
DE27 3390   $(DASD)/Z31VS1.CCKD cu=3990-6  sf=$(SHDW)/Z31VS1_*
DE28 3390   $(DASD)/OPEVS1.CCKD cu=3990-6  sf=$(SHDW)/OPEVS1_*
DE29 3390   $(DASD)/STGVS1.CCKD cu=3990-6  sf=$(SHDW)/STGVS1_*
DE2A 3390   $(DASD)/DEVVS1.CCKD cu=3990-6  sf=$(SHDW)/DEVVS1_*
DE2B 3390   $(DASD)/IMSV15.CCKD cu=3990-6   sf=$(SHDW)/IMSV15_*
DE2C 3390   $(DASD)/JCKVS1.CCKD cu=3990-6   sf=$(SHDW)/JCKSV1_*
DE2D 3390   $(DASD)/JSPVS1.CCKD cu=3990-6   sf=$(SHDW)/JSPVS1_*
DE2E 3390   $(DASD)/MQCD93.CCKD cu=3990-6 sf=$(SHDW)/MQCD93_*
DE2F 3390   $(DASD)/PRDVS1.CCKD cu=3990-6  sf=$(SHDW)/PRDVS1_*
DE30 3390   $(DASD)/DB2V13.CCKD cu=3990-6  sf=$(SHDW)/DB2V13_*
DE31 3390   $(DASD)/T31VS1.CCKD cu=3990-6  sf=$(SHDW)/T31VS1_*
DE32 3390   $(DASD)/ZFSVS1.CCKD cu=3990-6  sf=$(SHDW)/ZFSVS1_*
DE33 3390   $(DASD)/USRVS1.CCKD cu=3990-6  sf=$(SHDW)/USRVS1_*
DE34 3390   $(SPOOL)/JSPVS3.CCKD cu=3990-6
##DE34 3390   $(DASD)/JSPVS3.CCKD  sf=$(SHDW)/JSPVS3_*   cu=3990-6

DE00 3390   $(DASD)/SARES1.CKD  cu=3390-3
#DE01 3390
#DE02 3390
#DE03 3390
#DE04 3390
#DE05 3390
#DE06 3390
#DE07 3390
#DE08 3390
#DE09 3390
#DE0A 3390
#DE0B 3390
#DE0C 3390
#DE0D 3390
#DE0E 3390
#DE0F 3390

#**********************************************************************************************
#*****       LCS Adapters with z/OS                                                       *****
#**********************************************************************************************
#****0E20.2 LCS -n 192.168.43.35 192.168.43.225
#***********************************************************************
#*name	awsosa	0009	--path=A0	--pathtype=OSD	--tunnel_intf=y
#*device	1500	osa     osa	--unitadd=0
#*device	1501	osa	osa	--unitadd=1
#*device	1502	osa	osa	--unitadd=2
#*device	1503	osa	osa	--unitadd=3
#**********************************************************************
#1500.3 QETH iface /dev/net/tun iface 192.168.100.99 ipaddr 192.168.100.150 netmask 255.255.255.0 hwaddr 02-00-00-11-10-04 mtu 1500
1500.3 QETH iface C8-E2-65-21-27-21 ipaddr 192.168.50.150/24 netmask 255.255.255.0 hwaddr 02-00-00-11-10-00 mtu 1500 chpid F0

#**********************************************************************************************
#*****                 Master (0060) and terms 3270 (0061)                                *****
#**********************************************************************************************
#** dont change original DEVMAP parameters
#**name    aws3274 0002    #define a few 3270 terminals 
#**---> device  0060    3279    3274    mstcon  <-----
#**---> device  0061    3279    3274    tso1    <-----
#**
0060	3270
0061 	3270
0066      3270
0067      3270

#**  Netview terminals ??? **
0701	3270
0702	3270
0703	3270
0704	3270
0706	3270
0705	3270

#****************
#**********************************************************************************************
#*****             Fim da carga de parametros do arquivo de configuracao                  *****
#**********************************************************************************************
script IPL31.rc

###  don't forget on the first time, to create the shadow files with "sf+ *"
### also, original password was  "welcome0welcome0" new password for TSO  is "welcome1welcome1"
### and don't forget how to shut down the system via  "$netv shutsys" , "<stop" to stop RACF, "z eod" and "quience"

